<% layout('/layouts/boilerplate') -%>
<body><br>
    <h2 class="offset-3"><b> <%=listingDetail.title%> </b></h2>
  
   

 <div class="card offset-3 listing-card" style="width: 40rem;" >
     <img src=" <%=listingDetail.image%>" class="card-img-top" alt="...">
     <div class="card-body row" >
        <p class="card-text col-8">
          <i> ~Owned by <%=listingDetail.owner.username %>    </i>
            <ul>
            <li>  <%=listingDetail.description%>  </li>     
            <li> &#8377; <%=listingDetail.price.toLocaleString("en-IN")%></li><!--rupess symbol and (,)added ex-$21,000-->
            <li>  <%=listingDetail.location%>  </li>
            <li>  <%=listingDetail.country%>  </li> 
        
        </ul>
        </p>
        <%if(currUser&&currUser._id.equals(listingDetail.owner._id)){%>
          <div class="buttons">
           <button class="btn btn-danger "><a href="http://localhost:8080/listings/<%=listingDetail._id%>/edit" class="listing-link"> Edit details</a></button>
           <form  method="post" action="http://localhost:8080/listings/<%=listingDetail._id%>?_method=DELETE"><button class="btn btn-dark">Delete</button></form>
             <button class="button btn btn-primary"> <a href="http://localhost:8080/listings" class="listing-link">Back</a></button>        
   
         </div>
       
        <%}%>
          
    </div>


    <br>
    <hr>
    <div class="mb-3 mt-3">
        <h4>Leave a review</h4>
        <form  action="/listings/<%=listingDetail._id%>/reviews" method="POST" novalidate class="needs-validation" >
            <div class="mb-3 mt-3">
             <label for="rating" class="form-label">Rating</label>
             <input type="range" min="1" max="5" id="rating" name="review[rating]"  class="form-range"> 
            </div>

            <div class="mb-3 mt-3">
              <label for="comment" class="form-label">Comments</label>
              <textarea  rows="4" cols="24" id="comment" name="review[comment]" class="form-control"  required></textarea>
              <div class="invalid-feedback">
                   Please add some comment for a review.
                </div>
            </div>
            
            <button class="btn btn-outline-dark">Submit</button>




        </form>
    </div>
    <hr>
    <p><b>All Reviews</b></p>
    
    <div class="row ">
      <%for(review of listingDetail.reviews){%>
          
        <div class="card col-5 ms-3 mb-3 " style="width: 18rem;">
            <div class="card-body ">
              <p class="card-text"><%=  review.comment %></p> 
              <p class="card-text"><%= review.rating %> Stars</p>
            </div>
          <form action="/listings/<%=listingDetail._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST"><button class="btn btn-sm btn-dark mb-2">Delete</button></form>
        </div>

        <%}%>
    </div>
</div>

<br><br>
</body>
